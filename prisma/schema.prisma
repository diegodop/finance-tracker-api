generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  income
  expense
}

model Transaction {
  id          String          @id @default(uuid())
  description String
  amount      Decimal         @db.Decimal(12, 2)
  type        TransactionType
  category    String
  date        DateTime
  createdAt   DateTime        @default(now()) @map("created_at")

  @@map("transactions")
}
